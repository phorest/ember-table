<div
  data-test-ember-table-overflow
  class="ember-table-overflow"
  id="{{this.elementId}}-overflow"
>
  <table>
    {{yield (hash
      api=this.api
      head=(component (ensure-safe-component this.EmberThead) api=this.api)
      body=(component (ensure-safe-component this.EmberTbody) api=this.api)
      foot=(component (ensure-safe-component this.EmberTfoot) api=this.api)
      loadingMore=(component (ensure-safe-component this.EmberTableLoadingMore) api=this.api)
    )}}
  </table>
</div>
<EmberTablePrivate::ScrollIndicators @api={{this.api}} />
