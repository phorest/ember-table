{
  "name": "ember-table",
  "version": "6.0.0-12",
  "description": "An addon to support large data set and a number of features around table.",
  "keywords": [
    "ember-addon"
  ],
  "license": "BSD-3-Clause",
  "author": "",
  "repository": "https://github.com/Addepar/ember-table",
  "homepage": "https://Addepar.github.io/ember-table",
  "exports": {
    "./test-support": "./dist/test-support/index.js",
    "./default.scss": "./src/styles/default.scss",
    "./addon-main.js": "./addon-main.cjs",
    "./*": {
      "default": "./dist/*.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "src",
    "types"
  ],
  "scripts": {
    "build": "rollup --config",
    "start": "rollup --config --watch",
    "release": "release-it"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.0",
    "@embroider/util": "^1.13.2",
    "@html-next/vertical-collection": "^5.0.0",
    "css-element-queries": "^0.4.0",
    "ember-classy-page-object": "^0.8.0",
    "ember-raf-scheduler": "^0.5.0",
    "hammerjs": "^2.0.8"
  },
  "peerDependencies": {
    "@ember/test-helpers": ">= 2.9.4"
  },
  "peerDependenciesMeta": {
    "@ember/test-helpers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@embroider/addon-dev": "^8.4.2",
    "@rollup/plugin-babel": "^6.0.4",
    "@tsconfig/ember": "^1.0.1",
    "@types/ember__component": "^4.0.10",
    "babel-plugin-ember-template-compilation": "^2.3.0",
    "release-it": "^15.5.0",
    "rollup": "^4.60.0",
    "typescript": "^4.8.4"
  },
  "engines": {
    "node": ">= 18"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/ember-table-loading-more.js": "./dist/_app_/components/ember-table-loading-more.js",
      "./components/ember-table-simple-checkbox.js": "./dist/_app_/components/ember-table-simple-checkbox.js",
      "./components/ember-table.js": "./dist/_app_/components/ember-table.js",
      "./components/ember-tbody.js": "./dist/_app_/components/ember-tbody.js",
      "./components/ember-td.js": "./dist/_app_/components/ember-td.js",
      "./components/ember-tfoot.js": "./dist/_app_/components/ember-tfoot.js",
      "./components/ember-th.js": "./dist/_app_/components/ember-th.js",
      "./components/ember-th/resize-handle.js": "./dist/_app_/components/ember-th/resize-handle.js",
      "./components/ember-th/sort-indicator.js": "./dist/_app_/components/ember-th/sort-indicator.js",
      "./components/ember-thead.js": "./dist/_app_/components/ember-thead.js",
      "./components/ember-tr.js": "./dist/_app_/components/ember-tr.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "types/*"
      ]
    }
  }
}
